# Local Company Panel configuration. Copy this file to .env.local.
VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_USE_MOCK_API=false
VITE_API_TIMEOUT=15000
VITE_API_WITH_CREDENTIALS=false

# Use the HTTP origin where the Customer Website is running, without /access.
VITE_CUSTOMER_WEBSITE_DEV_ORIGIN=
