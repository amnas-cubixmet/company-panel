# CubixGear Company Panel -> Django backend
# Local Django:
VITE_API_URL=https://cardflow.pythonanywhere.com/api/v1

# Real backend mode
VITE_USE_MOCK_API=false

# Request timeout in milliseconds
VITE_API_TIMEOUT=15000

# JWT uses Authorization headers, so credentials are normally not required.
VITE_API_WITH_CREDENTIALS=false
